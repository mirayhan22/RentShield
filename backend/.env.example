# RentShield Backend — Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# Never commit real secrets to source control.
#
# NOTE: These names must match what backend/supabase_client.py reads.
#   SUPABASE_URL              (required) — your Supabase project URL
#   SUPABASE_ANON_KEY         (required unless SERVICE_ROLE key is set) — publishable/anon key
#   SUPABASE_SERVICE_ROLE_KEY (optional) — secret service-role key; takes precedence over the anon key
#   DEPLOYED_FRONTEND_URL     (optional) — deployed frontend origin for CORS
#
# Legacy aliases SUPABASE_PROJECT_URL and SUPABASE_PUBLISHABLE_KEY are also accepted.

SUPABASE_URL=https://your-project-ref.supabase.co

SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional: secret service-role key (starts with sb_secret_)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# Optional: deployed frontend URL for CORS
# DEPLOYED_FRONTEND_URL=https://your-app.vercel.app

# Optional: direct Postgres connection string (NOT read by the app yet).
# Quote the value — passwords may contain '#' which dotenv treats as a comment.
# Database_URL="postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
</parameter>
<parameter name="task_progress">- [x] Inspect all env reads in backend/ and api/
